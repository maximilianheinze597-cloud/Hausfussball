<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#080b12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Hausfussball">

<title>Hausfussball</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

:root {
  --bg:#080b12;
  --card:#111722;
  --card2:#171e2b;
  --border:#252e3d;
  --text:#f5f7fa;
  --muted:#8d98a8;
  --green:#20d879;
  --red:#ff4056;
  --yellow:#ffd43b;
  --blue:#3d8bfd;
}

body {
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  padding-bottom:90px;
}

button,input,textarea,select {
  font:inherit;
}

button {
  border:0;
  cursor:pointer;
}

.app {
  width:100%;
  max-width:760px;
  margin:0 auto;
}

header {
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(8,11,18,.94);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
  padding:calc(14px + env(safe-area-inset-top)) 16px 14px;
}

.header-inner {
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo {
  font-weight:900;
  font-size:21px;
}

.logo span {
  color:var(--green);
}

.live-pill {
  display:none;
  align-items:center;
  gap:7px;
  background:rgba(255,64,86,.13);
  color:#ff6b7b;
  border:1px solid rgba(255,64,86,.25);
  padding:7px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
}

.live-pill.active {
  display:flex;
}

.live-dot {
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--red);
  box-shadow:0 0 10px var(--red);
}

main {
  padding:18px 14px 30px;
}

.page {
  display:none;
}

.page.active {
  display:block;
}

.page-title {
  font-size:27px;
  font-weight:900;
  margin-bottom:5px;
}

.page-subtitle {
  color:var(--muted);
  font-size:14px;
  margin-bottom:20px;
}

.card {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:18px;
  padding:16px;
  margin-bottom:13px;
}

.card-title {
  font-size:16px;
  font-weight:800;
  margin-bottom:12px;
}

.hero {
  background:
    radial-gradient(circle at top right,rgba(32,216,121,.18),transparent 35%),
    linear-gradient(145deg,#111a22,#0c1018);
  border:1px solid var(--border);
  border-radius:23px;
  padding:23px 18px;
  margin-bottom:15px;
}

.hero-small {
  color:var(--green);
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:8px;
}

.hero h1 {
  font-size:30px;
  line-height:1.05;
  margin-bottom:10px;
}

.hero p {
  color:var(--muted);
  line-height:1.5;
  font-size:14px;
}

.home-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.home-button {
  min-height:105px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:18px;
  color:var(--text);
  text-align:left;
  padding:16px;
}

.home-icon {
  font-size:27px;
  margin-bottom:10px;
}

.home-button strong {
  display:block;
  font-size:15px;
}

.home-button small {
  color:var(--muted);
  display:block;
  margin-top:4px;
}

.match-card {
  background:
    radial-gradient(circle at 50% -20%,rgba(61,139,253,.18),transparent 45%),
    var(--card);
  border:1px solid var(--border);
  border-radius:22px;
  padding:20px 14px;
  text-align:center;
  margin-bottom:15px;
}

.match-status {
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 10px;
  border-radius:999px;
  background:rgba(32,216,121,.1);
  color:var(--green);
  font-size:11px;
  font-weight:900;
  margin-bottom:15px;
}

.match-status.finished {
  color:var(--muted);
  background:rgba(141,152,168,.1);
}

.scoreboard {
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:10px;
}

.team-name {
  font-weight:800;
  font-size:16px;
  word-break:break-word;
}

.team-score {
  font-size:46px;
  font-weight:950;
  letter-spacing:-2px;
}

.score-separator {
  font-size:27px;
  color:var(--muted);
}

.match-time {
  margin-top:7px;
  color:var(--green);
  font-weight:800;
  font-size:14px;
}

.match-date {
  margin-top:4px;
  color:var(--muted);
  font-size:12px;
}

.event {
  display:flex;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid var(--border);
}

.event:last-child {
  border-bottom:0;
}

.event-icon {
  width:35px;
  height:35px;
  display:grid;
  place-items:center;
  background:var(--card2);
  border-radius:11px;
  flex-shrink:0;
  font-size:18px;
}

.event-main {
  flex:1;
}

.event-title {
  font-weight:800;
  font-size:14px;
}

.event-info {
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
}

.event-minute {
  font-weight:900;
  font-size:13px;
  color:var(--green);
}

.btn {
  width:100%;
  padding:13px 15px;
  border-radius:13px;
  font-weight:850;
  color:white;
  background:var(--card2);
  border:1px solid var(--border);
  margin-top:8px;
}

.btn-green {
  background:var(--green);
  color:#06130c;
  border-color:var(--green);
}

.btn-red {
  background:rgba(255,64,86,.12);
  color:#ff7381;
  border-color:rgba(255,64,86,.3);
}

.btn-blue {
  background:var(--blue);
  border-color:var(--blue);
}

.btn-yellow {
  background:var(--yellow);
  color:#16130a;
  border-color:var(--yellow);
}

.button-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px;
}

.button-grid .btn {
  margin-top:0;
}

label {
  display:block;
  color:var(--muted);
  font-size:12px;
  font-weight:700;
  margin:12px 0 6px;
}

input,textarea,select {
  width:100%;
  background:#0b1018;
  color:var(--text);
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px;
  outline:none;
}

input:focus,textarea:focus,select:focus {
  border-color:var(--green);
}

.admin-lock {
  text-align:center;
  padding:20px 0;
}

.lock-icon {
  font-size:48px;
  margin-bottom:12px;
}

.admin-panel {
  display:none;
}

.admin-panel.active {
  display:block;
}

.admin-section {
  margin-bottom:18px;
}

.admin-section h3 {
  margin-bottom:10px;
  font-size:15px;
}

.danger-zone {
  border-color:rgba(255,64,86,.3);
}

.news-item {
  padding:16px 0;
  border-bottom:1px solid var(--border);
}

.news-item:last-child {
  border-bottom:0;
}

.news-tag {
  display:inline-block;
  font-size:10px;
  font-weight:900;
  color:var(--green);
  text-transform:uppercase;
  margin-bottom:6px;
}

.news-item h3 {
  font-size:17px;
  margin-bottom:5px;
}

.news-item p {
  color:var(--muted);
  font-size:13px;
  line-height:1.5;
}

.stats-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.stat-box {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px;
}

.stat-value {
  font-size:28px;
  font-weight:950;
}

.stat-label {
  color:var(--muted);
  font-size:12px;
  margin-top:4px;
}

.table-row {
  display:grid;
  grid-template-columns:40px 1fr 60px;
  gap:8px;
  align-items:center;
  padding:12px 0;
  border-bottom:1px solid var(--border);
}

.table-row:last-child {
  border-bottom:0;
}

.rank {
  font-weight:900;
  color:var(--muted);
}

.player {
  font-weight:800;
}

.player-team {
  color:var(--muted);
  font-size:11px;
  margin-top:2px;
}

.goals {
  text-align:right;
  font-size:20px;
  font-weight:950;
  color:var(--green);
}

.bracket {
  overflow-x:auto;
  padding-bottom:5px;
}

.bracket-inner {
  min-width:600px;
  display:flex;
  gap:28px;
  align-items:stretch;
}

.round {
  width:150px;
  flex-shrink:0;
}

.round-title {
  color:var(--muted);
  text-align:center;
  font-size:11px;
  font-weight:900;
  margin-bottom:12px;
  text-transform:uppercase;
}

.bracket-match {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:11px;
  overflow:hidden;
  margin-bottom:18px;
}

.bracket-team {
  padding:9px;
  font-size:12px;
  border-bottom:1px solid var(--border);
}

.bracket-team:last-child {
  border-bottom:0;
}

.bracket-team strong {
  float:right;
}

.bottom-nav {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  z-index:100;
  background:rgba(11,15,22,.96);
  backdrop-filter:blur(18px);
  border-top:1px solid var(--border);
  padding:7px 5px calc(7px + env(safe-area-inset-bottom));
}

.nav-inner {
  max-width:760px;
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(5,1fr);
}

.nav-button {
  background:transparent;
  color:var(--muted);
  padding:6px 2px;
  font-size:10px;
  font-weight:700;
}

.nav-icon {
  font-size:19px;
  display:block;
  margin-bottom:2px;
}

.nav-button.active {
  color:var(--green);
}

#toast {
  position:fixed;
  left:50%;
  bottom:92px;
  transform:translateX(-50%) translateY(20px);
  background:#f5f7fa;
  color:#080b12;
  padding:12px 17px;
  border-radius:13px;
  font-weight:800;
  font-size:13px;
  z-index:500;
  opacity:0;
  pointer-events:none;
  transition:.25s;
  max-width:90%;
  text-align:center;
}

#toast.show {
  opacity:1;
  transform:translateX(-50%) translateY(0);
}

.empty {
  text-align:center;
  padding:28px 10px;
  color:var(--muted);
}

.hidden {
  display:none!important;
}

@media (min-width:700px) {
  main {
    padding-left:0;
    padding-right:0;
  }

  .home-grid {
    grid-template-columns:repeat(4,1fr);
  }
}
</style>
</head>

<body>

<div class="app">

<header>
  <div class="header-inner">
    <div class="logo">⚽ <span>Haus</span>fussball</div>

    <div id="livePill" class="live-pill">
      <span class="live-dot"></span>
      LIVE
    </div>
  </div>
</header>

<main>

<section id="page-home" class="page active">

  <div class="hero">
    <div class="hero-small">⚽ Hausfussball</div>

    <h1>
      Alles live.<br>
      Jedes Tor.
    </h1>

    <p>
      Verfolge Spiele, Tore, Karten,
      Wechsel und alle wichtigen Ereignisse live.
    </p>
  </div>

  <div id="homeMatch"></div>

  <div class="home-grid">

    <button class="home-button" onclick="showPage('live')">
      <div class="home-icon">🔴</div>
      <strong>Live-Ticker</strong>
      <small>Aktuelles Spiel</small>
    </button>

    <button class="home-button" onclick="showPage('news')">
      <div class="home-icon">📰</div>
      <strong>News</strong>
      <small>Neuigkeiten</small>
    </button>

    <button class="home-button" onclick="showPage('cup')">
      <div class="home-icon">🏆</div>
      <strong>Pokal</strong>
      <small>Turnierbaum</small>
    </button>

    <button class="home-button" onclick="showPage('stats')">
      <div class="home-icon">📊</div>
      <strong>Stats</strong>
      <small>Spielstatistiken</small>
    </button>

    <button class="home-button" onclick="showPage('scorers')">
      <div class="home-icon">👑</div>
      <strong>Torschützen</strong>
      <small>Rangliste</small>
    </button>

    <button class="home-button" onclick="showPage('admin')">
      <div class="home-icon">🔐</div>
      <strong>Admin</strong>
      <small>Spiel verwalten</small>
    </button>

  </div>
</section>

<section id="page-live" class="page">

  <h1 class="page-title">🔴 Live-Ticker</h1>

  <p class="page-subtitle">
    Alle Ereignisse des aktuellen Spiels
  </p>

  <div id="liveMatch"></div>

  <div class="card">
    <div class="card-title">Spielereignisse</div>
    <div id="events"></div>
  </div>

</section>

<section id="page-news" class="page">

  <h1 class="page-title">📰 News</h1>

  <p class="page-subtitle">
    Neuigkeiten rund um deine Spiele
  </p>

  <div class="card">
    <div id="newsList"></div>
  </div>

</section>

<section id="page-cup" class="page">

  <h1 class="page-title">🏆 Pokal</h1>

  <p class="page-subtitle">Turnierbaum</p>

  <div class="card bracket">

    <div class="bracket-inner">

      <div class="round">

        <div class="round-title">
          Viertelfinale
        </div>

        <div class="bracket-match">
          <div class="bracket-team">
            Team A <strong>2</strong>
          </div>
          <div class="bracket-team">
            Team B <strong>1</strong>
          </div>
        </div>

        <div class="bracket-match">
          <div class="bracket-team">
            Team C <strong>3</strong>
          </div>
          <div class="bracket-team">
            Team D <strong>0</strong>
          </div>
        </div>

        <div class="bracket-match">
          <div class="bracket-team">
            Team E <strong>1</strong>
          </div>
          <div class="bracket-team">
            Team F <strong>2</strong>
          </div>
        </div>

        <div class="bracket-match">
          <div class="bracket-team">
            Team G <strong>2</strong>
          </div>
          <div class="bracket-team">
            Team H <strong>0</strong>
          </div>
        </div>

      </div>

      <div class="round">

        <div class="round-title">
          Halbfinale
        </div>

        <div class="bracket-match" style="margin-top:35px">
          <div class="bracket-team">
            Team A <strong>–</strong>
          </div>
          <div class="bracket-team">
            Team C <strong>–</strong>
          </div>
        </div>

        <div class="bracket-match" style="margin-top:54px">
          <div class="bracket-team">
            Team F <strong>–</strong>
          </div>
          <div class="bracket-team">
            Team G <strong>–</strong>
          </div>
        </div>

      </div>

      <div class="round">

        <div class="round-title">
          Finale
        </div>

        <div class="bracket-match" style="margin-top:105px">

          <div class="bracket-team">
            Sieger HF 1 <strong>–</strong>
          </div>

          <div class="bracket-team">
            Sieger HF 2 <strong>–</strong>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<section id="page-stats" class="page">

  <h1 class="page-title">📊 Stats</h1>

  <p class="page-subtitle">
    Statistiken des aktuellen Spiels
  </p>

  <div class="stats-grid">

    <div class="stat-box">
      <div id="statGoals" class="stat-value">0</div>
      <div class="stat-label">Tore</div>
    </div>

    <div class="stat-box">
      <div id="statFouls" class="stat-value">0</div>
      <div class="stat-label">Fouls</div>
    </div>

    <div class="stat-box">
      <div id="statCorners" class="stat-value">0</div>
      <div class="stat-label">Ecken</div>
    </div>

    <div class="stat-box">
      <div id="statCards" class="stat-value">0</div>
      <div class="stat-label">Karten</div>
    </div>

    <div class="stat-box">
      <div id="statSubs" class="stat-value">0</div>
      <div class="stat-label">Wechsel</div>
    </div>

    <div class="stat-box">
      <div id="statFreeKicks" class="stat-value">0</div>
      <div class="stat-label">Freistöße</div>
    </div>

  </div>
</section>

<section id="page-scorers" class="page">

  <h1 class="page-title">👑 Torschützenliste</h1>

  <p class="page-subtitle">
    Die besten Torschützen
  </p>

  <div class="card">
    <div id="scorerList"></div>
  </div>

</section>

<section id="page-admin" class="page">

  <h1 class="page-title">🔐 Admin</h1>

  <p class="page-subtitle">
    Spiel und Live-Ticker verwalten
  </p>

  <div id="loginBox" class="card admin-lock">

    <div class="lock-icon">🔐</div>

    <h2>Admin-Login</h2>

    <label>Passwort</label>

    <input
      id="adminPassword"
      type="password"
      placeholder="Passwort eingeben"
    >

    <button class="btn btn-green" onclick="login()">
      Einloggen
    </button>

  </div>

  <div id="adminPanel" class="admin-panel">

    <div class="card admin-section">

      <h3>⚽ Spiel</h3>

      <label>Heimteam</label>

      <input
        id="homeTeam"
        placeholder="z. B. Team A"
      >

      <label>Auswärtsteam</label>

      <input
        id="awayTeam"
        placeholder="z. B. Team B"
      >

      <label>Datum</label>

      <input
        id="matchDate"
        type="date"
      >

      <button class="btn btn-blue" onclick="saveMatch()">
        💾 Spiel speichern
      </button>

    </div>

    <div class="card admin-section">

      <h3>⚽ Spielsteuerung</h3>

      <div class="button-grid">

        <button class="btn btn-green" onclick="startMatch()">
          ⚽ Anpfiff
        </button>

        <button class="btn" onclick="halfTime()">
          ⏸️ Halbzeit
        </button>

        <button class="btn btn-red" onclick="finishMatch()">
          🏁 Abpfiff
        </button>

        <button class="btn" onclick="undoLast()">
          ↩️ Rückgängig
        </button>

      </div>

    </div>

    <div class="card admin-section">

      <h3>⚡ Ereignis hinzufügen</h3>

      <label>Minute</label>

      <input
        id="eventMinute"
        type="number"
        min="0"
        placeholder="z. B. 23"
      >

      <label>Team</label>

      <select id="eventTeam">

        <option value="home">
          Heimteam
        </option>

        <option value="away">
          Auswärtsteam
        </option>

      </select>

      <label>Spieler</label>

      <input
        id="eventPlayer"
        placeholder="Spielername"
      >

      <div class="button-grid">

        <button class="btn btn-green" onclick="addEvent('goal')">
          ⚽ Tor
        </button>

        <button class="btn" onclick="addEvent('foul')">
          🛑 Foul
        </button>

        <button class="btn btn-green" onclick="addEvent('penalty')">
          🟢 Elfmeter
        </button>

        <button class="btn" onclick="addEvent('freekick')">
          🎯 Freistoß
        </button>

        <button class="btn" onclick="addEvent('corner')">
          🚩 Ecke
        </button>

        <button class="btn btn-yellow" onclick="addEvent('yellow')">
          🟨 Gelb
        </button>

        <button class="btn btn-red" onclick="addEvent('red')">
          🟥 Rot
        </button>

        <button class="btn" onclick="addEvent('sub')">
          🔄 Wechsel
        </button>

      </div>

    </div>

    <div class="card danger-zone">

      <h3>⚠️ Verwaltung</h3>

      <button class="btn btn-red" onclick="resetMatch()">
        🗑️ Spiel zurücksetzen
      </button>

      <button class="btn" onclick="logout()">
        🔒 Ausloggen
      </button>

    </div>

  </div>

</section>

</main>

<nav class="bottom-nav">

  <div class="nav-inner">

    <button
      class="nav-button active"
      data-page="home"
      onclick="showPage('home')"
    >
      <span class="nav-icon">🏠</span>
      Home
    </button>

    <button
      class="nav-button"
      data-page="live"
      onclick="showPage('live')"
    >
      <span class="nav-icon">🔴</span>
      Live
    </button>

    <button
      class="nav-button"
      data-page="news"
      onclick="showPage('news')"
    >
      <span class="nav-icon">📰</span>
      News
    </button>

    <button
      class="nav-button"
      data-page="stats"
      onclick="showPage('stats')"
    >
      <span class="nav-icon">📊</span>
      Stats
    </button>

    <button
      class="nav-button"
      data-page="admin"
      onclick="showPage('admin')"
    >
      <span class="nav-icon">🔐</span>
      Admin
    </button>

  </div>

</nav>

</div>

<div id="toast"></div>

<script>

/* =========================================
   CLOUDFLARE WORKER
========================================= */

const API_URL =
  "https://hausfussball-live.maximilianheinze597.workers.dev";


/* =========================================
   GRUNDDATEN
========================================= */

const defaultData = {

  homeTeam:"Heimteam",

  awayTeam:"Auswärtsteam",

  homeScore:0,

  awayScore:0,

  date:"",

  status:"not_started",

  startTime:null,

  elapsed:0,

  events:[],

  scorers:{}

};


let data =
  structuredClone(defaultData);

let timer = null;

let adminLoggedIn = false;


/* =========================================
   LOKALE DATEN LADEN
========================================= */

function loadLocalData() {

  try {

    const saved =
      localStorage.getItem(
        "hausfussball_data"
      );

    if (!saved) {
      return structuredClone(defaultData);
    }

    return {
      ...structuredClone(defaultData),
      ...JSON.parse(saved)
    };

  } catch(error) {

    console.error(error);

    return structuredClone(defaultData);

  }

}


/* =========================================
   ONLINE-DATEN LADEN
========================================= */

async function loadOnlineData() {

  try {

    const response =
      await fetch(
        API_URL + "/api/state",
        {
          cache:"no-store"
        }
      );

    if (!response.ok) {
      throw new Error(
        "Server antwortet mit " +
        response.status
      );
    }

    const result =
      await response.json();

    if (
      result.ok &&
      result.state
    ) {

      /*
        Der Worker speichert
        den kompletten Spielstand
        in state.fullState.
      */

      if (result.state.fullState) {

        data =
          {
            ...structuredClone(defaultData),
            ...result.state.fullState
          };

      } else {

        /*
          Falls eine ältere Version
          des Workers vorhanden ist,
          werden zumindest Score
          und Events übernommen.
        */

        if (
          typeof result.state.home === "number"
        ) {
          data.homeScore =
            result.state.home;
        }

        if (
          typeof result.state.away === "number"
        ) {
          data.awayScore =
            result.state.away;
        }

        if (
          Array.isArray(
            result.state.events
          )
        ) {

          data.events =
            result.state.events;

        }

      }

      localStorage.setItem(
        "hausfussball_data",
        JSON.stringify(data)
      );

      renderAll();

      if (
        data.status === "live"
      ) {

        startTimer();

      } else {

        stopTimer();

      }

    }

  } catch(error) {

    console.error(
      "Cloudflare-Daten konnten nicht geladen werden:",
      error
    );

  }

}


/* =========================================
   KOMPLETTEN SPIELSTAND ONLINE SPEICHERN
========================================= */

async function saveData() {

  /*
    Zuerst lokal speichern.
    Dadurch funktioniert die App
    auch bei kurzer Internetunterbrechung.
  */

  localStorage.setItem(
    "hausfussball_data",
    JSON.stringify(data)
  );

  renderAll();


  try {

    const response =
      await fetch(
        API_URL + "/api/event",
        {
          method:"POST",

          headers:{
            "Content-Type":
              "application/json"
          },

          body:JSON.stringify({

            home:data.homeScore,

            away:data.awayScore,

            event:{
              fullState:data
            }

          })

        }
      );


    if (!response.ok) {

      throw new Error(
        "Cloudflare HTTP " +
        response.status
      );

    }


    const result =
      await response.json();


    if (!result.ok) {

      console.error(
        "Cloudflare Fehler:",
        result
      );

    } else {

      console.log(
        "☁️ Spielstand online gespeichert"
      );

    }

  } catch(error) {

    console.error(
      "Online-Speicherung fehlgeschlagen:",
      error
    );

  }

}


/* =========================================
   NAVIGATION
========================================= */

function showPage(page) {

  document
    .querySelectorAll(".page")
    .forEach(section => {

      section.classList.remove(
        "active"
      );

    });


  const target =
    document.getElementById(
      "page-" + page
    );


  if (target) {

    target.classList.add(
      "active"
    );

  }


  document
    .querySelectorAll(".nav-button")
    .forEach(button => {

      button.classList.toggle(
        "active",
        button.dataset.page === page
      );

    });


  window.scrollTo({
    top:0,
    behavior:"smooth"
  });


  renderAll();

}


/* =========================================
   ADMIN LOGIN
========================================= */

function login() {

  const password =
    document.getElementById(
      "adminPassword"
    ).value;


  if (password === "admin") {

    adminLoggedIn = true;

    document
      .getElementById("loginBox")
      .classList.add("hidden");

    document
      .getElementById("adminPanel")
      .classList.add("active");

    toast(
      "✅ Admin-Modus aktiviert"
    );

  } else {

    toast(
      "❌ Falsches Passwort"
    );

  }

}


function logout() {

  adminLoggedIn = false;

  document
    .getElementById("loginBox")
    .classList.remove("hidden");

  document
    .getElementById("adminPanel")
    .classList.remove("active");

  toast(
    "🔒 Ausgeloggt"
  );

}


/* =========================================
   SPIEL SPEICHERN
========================================= */

function saveMatch() {

  if (!adminLoggedIn) {

    toast(
      "🔐 Bitte zuerst einloggen"
    );

    return;

  }


  const home =
    document
      .getElementById("homeTeam")
      .value
      .trim();


  const away =
    document
      .getElementById("awayTeam")
      .value
      .trim();


  const date =
    document
      .getElementById("matchDate")
      .value;


  if (!home || !away) {

    toast(
      "Bitte beide Teams eingeben"
    );

    return;

  }


  data.homeTeam = home;

  data.awayTeam = away;

  data.date = date;


  saveData();


  toast(
    "✅ Spiel gespeichert"
  );

}


/* =========================================
   ANPFIFF
========================================= */

function startMatch() {

  if (!adminLoggedIn) {

    toast(
      "🔐 Bitte zuerst einloggen"
    );

    return;

  }


  data.status = "live";


  if (!data.startTime) {

    data.startTime =
      Date.now();

  }


  addSystemEvent(
    "⚽",
    "Anpfiff",
    "Das Spiel wurde gestartet."
  );


  saveData();

  startTimer();


  toast(
    "⚽ ANPFIFF!"
  );

}


/* =========================================
   HALBZEIT
========================================= */

function halfTime() {

  if (!adminLoggedIn) {
    return;
  }


  data.status =
    "halftime";


  addSystemEvent(
    "⏸️",
    "Halbzeit",
    "Halbzeitpause."
  );


  saveData();

  stopTimer();


  toast(
    "⏸️ Halbzeit"
  );

}


/* =========================================
   ABPFIFF
========================================= */

function finishMatch() {

  if (!adminLoggedIn) {
    return;
  }


  data.status =
    "finished";


  addSystemEvent(
    "🏁",
    "Abpfiff",
    `Endstand ${data.homeScore}:${data.awayScore}`
  );


  saveData();

  stopTimer();


  toast(
    "🏁 ABPFIFF!"
  );

}


/* =========================================
   TIMER
========================================= */

function startTimer() {

  stopTimer();


  timer =
    setInterval(() => {

      if (
        data.status !== "live"
      ) {

        return;

      }


      data.elapsed =
        Math.floor(
          (
            Date.now()
            -
            data.startTime
          )
          /
          1000
        );


      renderMatch();

    },1000);

}


function stopTimer() {

  if (timer) {

    clearInterval(timer);

    timer = null;

  }

}


function getMatchMinute() {

  if (!data.startTime) {

    return data.elapsed
      ? Math.floor(
          data.elapsed / 60
        )
      : 0;

  }


  return Math.floor(
    (
      Date.now()
      -
      data.startTime
    )
    /
    60000
  );

}


/* =========================================
   EVENT-TYPEN
========================================= */

const eventTypes = {

  goal:{
    icon:"⚽",
    title:"Tor"
  },

  foul:{
    icon:"🛑",
    title:"Foul"
  },

  penalty:{
    icon:"🟢",
    title:"Elfmeter"
  },

  freekick:{
    icon:"🎯",
    title:"Freistoß"
  },

  corner:{
    icon:"🚩",
    title:"Ecke"
  },

  yellow:{
    icon:"🟨",
    title:"Gelbe Karte"
  },

  red:{
    icon:"🟥",
    title:"Rote Karte"
  },

  sub:{
    icon:"🔄",
    title:"Wechsel"
  }

};


/* =========================================
   EVENT HINZUFÜGEN
========================================= */

function addEvent(type) {

  if (!adminLoggedIn) {

    toast(
      "🔐 Bitte zuerst einloggen"
    );

    return;

  }


  const minuteInput =
    document
      .getElementById("eventMinute")
      .value;


  const player =
    document
      .getElementById("eventPlayer")
      .value
      .trim();


  const team =
    document
      .getElementById("eventTeam")
      .value;


  const minute =
    minuteInput !== ""
      ? Number(minuteInput)
      : getMatchMinute();


  const eventInfo =
    eventTypes[type];


  if (!eventInfo) {
    return;
  }


  const event = {

    id:Date.now(),

    type,

    minute,

    team,

    player,

    timestamp:Date.now()

  };


  data.events.push(
    event
  );


  if (
    type === "goal"
    ||
    type === "penalty"
  ) {

    if (team === "home") {

      data.homeScore++;

    } else {

      data.awayScore++;

    }


    if (player) {

      if (
        !data.scorers[player]
      ) {

        data.scorers[player] =
          0;

      }


      data.scorers[player]++;

    }


    toast(
      `⚽ TOR! ${
        team === "home"
          ? data.homeTeam
          : data.awayTeam
      }`
    );

  } else {

    toast(
      `${eventInfo.icon} ${eventInfo.title} hinzugefügt`
    );

  }


  document
    .getElementById("eventMinute")
    .value = "";


  document
    .getElementById("eventPlayer")
    .value = "";


  saveData();

}


/* =========================================
   SYSTEM-EVENT
========================================= */

function addSystemEvent(
  icon,
  title,
  info
) {

  data.events.push({

    id:Date.now(),

    type:"system",

    icon,

    title,

    info,

    minute:getMatchMinute(),

    timestamp:Date.now()

  });

}


/* =========================================
   RÜCKGÄNGIG
========================================= */

function undoLast() {

  if (!adminLoggedIn) {
    return;
  }


  if (
    data.events.length === 0
  ) {

    toast(
      "Keine Ereignisse vorhanden"
    );

    return;

  }


  const event =
    data.events[
      data.events.length - 1
    ];


  if (
    event.type === "goal"
    ||
    event.type === "penalty"
  ) {

    if (
      event.team === "home"
    ) {

      data.homeScore =
        Math.max(
          0,
          data.homeScore - 1
        );

    } else {

      data.awayScore =
        Math.max(
          0,
          data.awayScore - 1
        );

    }


    if (
      event.player &&
      data.scorers[event.player]
    ) {

      data.scorers[event.player]--;

      if (
        data.scorers[event.player] <= 0
      ) {

        delete data.scorers[
          event.player
        ];

      }

    }

  }


  data.events.pop();


  saveData();


  toast(
    "↩️ Letztes Ereignis rückgängig"
  );

}


/* =========================================
   RESET
========================================= */

async function resetMatch() {

  if (!adminLoggedIn) {
    return;
  }


  const confirmed =
    confirm(
      "Soll das komplette Spiel wirklich gelöscht werden?"
    );


  if (!confirmed) {
    return;
  }


  data =
    structuredClone(
      defaultData
    );


  localStorage.setItem(
    "hausfussball_data",
    JSON.stringify(data)
  );


  stopTimer();


  try {

    const response =
      await fetch(
        API_URL + "/api/state",
        {
          method:"DELETE"
        }
      );


    if (!response.ok) {
      throw new Error(
        "Reset fehlgeschlagen"
      );
    }


    toast(
      "🗑️ Spiel online zurückgesetzt"
    );

  } catch(error) {

    console.error(error);

    toast(
      "⚠️ Online-Reset fehlgeschlagen"
    );

  }


  renderAll();

}


/* =========================================
   MATCH RENDERN
========================================= */

function renderMatch() {

  const live =
    data.status === "live";


  const statusText = {

    not_started:
      "Noch nicht gestartet",

    live:
      "LIVE",

    halftime:
      "HALBZEIT",

    finished:
      "ABGEPFIFFEN"

  }[
    data.status
  ] || "–";


  const minute =
    data.status === "live"
      ? getMatchMinute()
      : data.elapsed
        ? Math.floor(
            data.elapsed / 60
          )
        : 0;


  const html = `

    <div class="match-card">

      <div class="match-status ${
        data.status === "finished"
          ? "finished"
          : ""
      }">

        ${
          live
            ? '<span class="live-dot"></span>'
            : ""
        }

        ${statusText}

      </div>

      <div class="scoreboard">

        <div class="team-name">
          ${escapeHTML(data.homeTeam)}
        </div>

        <div>

          <div class="team-score">

            ${data.homeScore}

            <span class="score-separator">
              :
            </span>

            ${data.awayScore}

          </div>

          ${
            data.status === "live"
              ? `
                <div class="match-time">
                  ${minute}'
                </div>
              `
              : ""
          }

        </div>

        <div class="team-name">
          ${escapeHTML(data.awayTeam)}
        </div>

      </div>

      ${
        data.date
          ? `
            <div class="match-date">
              ${formatDate(data.date)}
            </div>
          `
          : ""
      }

    </div>

  `;


  document
    .getElementById("liveMatch")
    .innerHTML = html;


  document
    .getElementById("homeMatch")
    .innerHTML = html;


  document
    .getElementById("livePill")
    .classList.toggle(
      "active",
      live
    );

}


/* =========================================
   EVENTS RENDERN
========================================= */

function renderEvents() {

  const container =
    document.getElementById(
      "events"
    );


  if (
    !data.events.length
  ) {

    container.innerHTML = `
      <div class="empty">
        Noch keine Ereignisse.
      </div>
    `;

    return;

  }


  const events =
    [...data.events]
      .reverse();


  container.innerHTML =
    events
      .map(event => {

        const icon =
          event.icon
          ||
          eventTypes[
            event.type
          ]?.icon
          ||
          "ℹ️";


        const title =
          event.title
          ||
          eventTypes[
            event.type
          ]?.title
          ||
          "Ereignis";


        let info =
          event.info
          ||
          "";


        if (!info) {

          const team =
            event.team === "home"
              ? data.homeTeam
              : data.awayTeam;


          info =
            [
              team,
              event.player
            ]
            .filter(Boolean)
            .join(" • ");

        }


        return `

          <div class="event">

            <div class="event-icon">
              ${icon}
            </div>

            <div class="event-main">

              <div class="event-title">
                ${escapeHTML(title)}
              </div>

              <div class="event-info">
                ${escapeHTML(info)}
              </div>

            </div>

            <div class="event-minute">
              ${event.minute || 0}'
            </div>

          </div>

        `;

      })
      .join("");

}


/* =========================================
   STATS
========================================= */

function renderStats() {

  const count =
    type =>
      data.events.filter(
        event =>
          event.type === type
      ).length;


  document.getElementById(
    "statGoals"
  ).textContent =
    count("goal") +
    count("penalty");


  document.getElementById(
    "statFouls"
  ).textContent =
    count("foul");


  document.getElementById(
    "statCorners"
  ).textContent =
    count("corner");


  document.getElementById(
    "statCards"
  ).textContent =
    count("yellow") +
    count("red");


  document.getElementById(
    "statSubs"
  ).textContent =
    count("sub");


  document.getElementById(
    "statFreeKicks"
  ).textContent =
    count("freekick");

}


/* =========================================
   TORSCHÜTZEN
========================================= */

function renderScorers() {

  const container =
    document.getElementById(
      "scorerList"
    );


  const scorers =
    Object.entries(
      data.scorers || {}
    )
    .sort(
      (a,b) =>
        b[1] - a[1]
    );


  if (!scorers.length) {

    container.innerHTML = `
      <div class="empty">
        Noch keine Torschützen.
      </div>
    `;

    return;

  }


  container.innerHTML =
    scorers
      .map(
        ([player,goals],index) => `

          <div class="table-row">

            <div class="rank">
              ${index + 1}
            </div>

            <div>

              <div class="player">
                ${escapeHTML(player)}
              </div>

              <div class="player-team">
                Torschütze
              </div>

            </div>

            <div class="goals">
              ${goals}
            </div>

          </div>

        `
      )
      .join("");

}


/* =========================================
   NEWS
========================================= */

function renderNews() {

  const container =
    document.getElementById(
      "newsList"
    );


  const latest =
    [...data.events]
      .reverse()
      .slice(0,8);


  if (!latest.length) {

    container.innerHTML = `

      <div class="news-item">

        <div class="news-tag">
          LIVE
        </div>

        <h3>
          Willkommen bei Hausfussball
        </h3>

        <p>
          Sobald das Spiel beginnt,
          erscheinen hier automatisch
          die neuesten Ereignisse.
        </p>

      </div>

    `;

    return;

  }


  container.innerHTML =
    latest
      .map(event => {

        const icon =
          event.icon
          ||
          eventTypes[
            event.type
          ]?.icon
          ||
          "ℹ️";


        const title =
          event.title
          ||
          eventTypes[
            event.type
          ]?.title
          ||
          "Ereignis";


        return `

          <div class="news-item">

            <div class="news-tag">
              ${icon}
              ${event.minute || 0}'
            </div>

            <h3>
              ${escapeHTML(title)}
            </h3>

            <p>
              ${escapeHTML(
                event.info
                ||
                event.player
                ||
                (
                  event.team === "home"
                    ? data.homeTeam
                    : data.awayTeam
                )
              )}
            </p>

          </div>

        `;

      })
      .join("");

}


/* =========================================
   ADMIN FORMULAR
========================================= */

function renderAdmin() {

  const home =
    document.getElementById(
      "homeTeam"
    );


  const away =
    document.getElementById(
      "awayTeam"
    );


  const date =
    document.getElementById(
      "matchDate"
    );


  if (
    home &&
    document.activeElement !== home
  ) {

    home.value =
      data.homeTeam;

  }


  if (
    away &&
    document.activeElement !== away
  ) {

    away.value =
      data.awayTeam;

  }


  if (
    date &&
    document.activeElement !== date
  ) {

    date.value =
      data.date || "";

  }

}


/* =========================================
   ALLES RENDERN
========================================= */

function renderAll() {

  renderMatch();

  renderEvents();

  renderStats();

  renderScorers();

  renderNews();

  renderAdmin();

}


/* =========================================
   HILFSFUNKTIONEN
========================================= */

function escapeHTML(value) {

  return String(
    value ?? ""
  )

    .replaceAll(
      "&",
      "&amp;"
    )

    .replaceAll(
      "<",
      "&lt;"
    )

    .replaceAll(
      ">",
      "&gt;"
    )

    .replaceAll(
      '"',
      "&quot;"
    )

    .replaceAll(
      "'",
      "&#039;"
    );

}


function formatDate(date) {

  if (!date) {
    return "";
  }


  const parts =
    date.split("-");


  if (
    parts.length !== 3
  ) {

    return date;

  }


  return `
    ${parts[2]}.
    ${parts[1]}.
    ${parts[0]}
  `;

}


function toast(message) {

  const element =
    document.getElementById(
      "toast"
    );


  element.textContent =
    message;


  element.classList.add(
    "show"
  );


  clearTimeout(
    window.toastTimer
  );


  window.toastTimer =
    setTimeout(
      () => {

        element.classList.remove(
          "show"
        );

      },
      2500
    );

}


/* =========================================
   START
========================================= */

data =
  loadLocalData();

renderAll();


if (
  data.status === "live"
) {

  startTimer();

}


/*
  Direkt beim Öffnen
  aktuellen Spielstand holen.
*/

loadOnlineData();


/*
  Alle 3 Sekunden synchronisieren.

  Dadurch sehen andere Handys
  neue Tore und Ereignisse
  automatisch.
*/

setInterval(
  loadOnlineData,
  3000
);


/*
  Beim Zurückkehren in die App
  sofort aktualisieren.
*/

document.addEventListener(
  "visibilitychange",
  () => {

    if (!document.hidden) {

      loadOnlineData();

    }

  }
);

</script>

